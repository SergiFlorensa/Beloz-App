DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render tambien puede inyectar esta variable desde render.yaml.
# La app convierte postgresql:// y postgres:// a postgresql+asyncpg:// automaticamente.
# EXTERNAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTO_CREATE_TABLES=true
CORS_ORIGINS=*
SQL_ECHO=false
